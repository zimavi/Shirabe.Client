<!-- Copy to Secrets.local.props (git-ignored) and fill in your own key and shared secret from
     https://www.last.fm/api/account/create. Both end up inside the built app. -->
<Project>
    <PropertyGroup>
        <LastFmApiKey></LastFmApiKey>
        <LastFmApiSecret></LastFmApiSecret>
    </PropertyGroup>
</Project>
