<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use platform-specific APIs, use conditional compilation.
        See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AssemblyName>Shirabe</AssemblyName>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
      <!-- The icon of Shirabe.exe itself (Explorer, taskbar pins, shortcuts). -->
      <ApplicationIcon>..\Shirabe.Client\Assets\app.ico</ApplicationIcon>
    </PropertyGroup>

  <!-- For packagers whose package manager owns the updates, even of a Velopack-packed build: -p:SelfUpdate=false
       builds an app that only says a new release exists. -->
  <PropertyGroup Condition="'$(SelfUpdate)' == 'false'">
    <DefineConstants>$(DefineConstants);NO_SELF_UPDATE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\LICENSE.txt;..\NOTICE.txt">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

  <ItemGroup>
        <ProjectReference Include="..\Shirabe.Client\Shirabe.Client.csproj"/>
    </ItemGroup>

    <Import Project="..\build\BassNative.props"/>
</Project>
