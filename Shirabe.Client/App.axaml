<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Shirabe.Client"
             x:Class="Shirabe.Client.App"
             RequestedThemeVariant="Dark">
    <!-- Dark only for now: the layout is modelled on Cider, which is dark-first. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Shirabe.Client/Styles/Theme.axaml" />
                <ResourceInclude Source="avares://Shirabe.Client/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Accent must match AccentColor in Styles/Theme.axaml -->
                <ColorPaletteResources x:Key="Dark" Accent="#E8456B" RegionColor="#121214" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Shirabe.Client/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
