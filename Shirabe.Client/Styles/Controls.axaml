<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <!-- Horizontal slider: thin track, accent fill. A ControlTheme, because a plain Style cannot replace
             Fluent's template. Same part names as Fluent's, so seeking and dragging keep working. -->
        <ControlTheme x:Key="ShirabeSlider" TargetType="Slider">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Height="20" Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource TrackBrush}" />
                        <Track Name="PART_Track" Orientation="Horizontal" VerticalAlignment="Center"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="4" CornerRadius="2" Margin="0,0,-6,0" Background="{DynamicResource AccentBrush}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="4" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                            <Thumb Name="thumb" Width="12" Height="12">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Ellipse Fill="{DynamicResource TextPrimaryBrush}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- Window caption buttons (minimize, maximize, close): <Button Classes="caption"> (+ "close") -->
    <Style Selector="Button.caption">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button.caption /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Small icon-only button (shuffle, repeat, previous, next, queue). Add "active" to show it as switched on. -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.icon.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.icon:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Sidebar navigation entry: <Button Classes="nav"> (add "selected" for the active one) -->
    <Style Selector="Button.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Round play/pause button -->
    <Style Selector="Button.play">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.play /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="Button.play:pointerover">
        <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.play:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Sliders use Theme="{StaticResource ShirabeSlider}" (see Styles.Resources below).
         The thumb is visible only while hovered. -->
    <Style Selector="Slider.shirabe:not(:pointerover) /template/ Thumb">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Slider.shirabe:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Disabled means nothing is loaded: Minimum equals Maximum, which the track would draw as completely filled -->
    <Style Selector="Slider.shirabe:disabled /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Small muted section heading in the sidebar -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Drop target: dashed outline, accent while a drag is over the window -->
    <Style Selector="Panel.dropzone > Rectangle">
        <Setter Property="Stroke" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeDashArray" Value="6,6" />
        <Setter Property="RadiusX" Value="16" />
        <Setter Property="RadiusY" Value="16" />
    </Style>
    <!-- MainView carries the "dragover" class while a drag is over the window -->
    <Style Selector=".dragover Panel.dropzone > Rectangle">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Fill" Value="{DynamicResource SurfaceBrush}" />
    </Style>

    <!-- Primary action button -->
    <Style Selector="Button.accent">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.accent:pointerover">
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.accent:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Secondary button: quiet, for things like Cancel -->
    <Style Selector="Button.quiet /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <!-- Page headings -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Song list rows -->
    <Style Selector="ListBox.songs">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.songs ListBoxItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.songs ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="ListBox.songs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="ListBox.songs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <!-- Play button over a song's cover: dark veil, hidden until the row is hovered -->
    <Style Selector="Button.cover-play">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.cover-play PathIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Button.cover-play /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    </Style>
    <Style Selector="Button.cover-play:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.cover-play:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ListBox.songs ListBoxItem:pointerover Button.cover-play">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Queue rows: the song that is playing is highlighted -->
    <Style Selector="Border.queue-row.current">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.queue-row.current TextBlock.title">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Height" Value="4" />
    </Style>
</Styles>
