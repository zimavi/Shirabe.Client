<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
    </ItemGroup>

  <!-- Shirabe's own Last.fm API key and shared secret, from environment variables of these names (CI) or from the
       git-ignored file below. A build without them works, only without Last.fm. -->
  <Import Project="../build/Secrets.local.props" Condition="Exists('../build/Secrets.local.props')"/>
  <ItemGroup Condition="'$(LastFmApiKey)' != '' And '$(LastFmApiSecret)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LastFmApiKey</_Parameter1>
      <_Parameter2>$(LastFmApiKey.Trim())</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LastFmApiSecret</_Parameter1>
      <_Parameter2>$(LastFmApiSecret.Trim())</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="DiscordRichPresence"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Shirabe.Core\Shirabe.Core.csproj"/>
        <ProjectReference Include="..\Shirabe.Audio\Shirabe.Audio.csproj"/>
        <ProjectReference Include="..\Shirabe.Library\Shirabe.Library.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\PlayerBarView.axaml.cs">
        <DependentUpon>PlayerBarView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\HomeView.axaml.cs">
        <DependentUpon>HomeView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\CoverView.axaml.cs">
        <DependentUpon>CoverView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\PropertiesView.axaml.cs">
        <DependentUpon>PropertiesView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Studio\StudioView.axaml.cs">
        <DependentUpon>StudioView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\ApplyView.axaml.cs">
        <DependentUpon>ApplyView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Studio\StudioApplyView.axaml.cs">
        <DependentUpon>StudioApplyView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Studio\StudioEditorView.axaml.cs">
        <DependentUpon>StudioEditorView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\LyricsView.axaml.cs">
        <DependentUpon>LyricsView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\LyricsSettingsView.axaml.cs">
        <DependentUpon>LyricsSettingsView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\ShortcutsSettingsView.axaml.cs">
        <DependentUpon>ShortcutsSettingsView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\SpeedMenuView.axaml.cs">
        <DependentUpon>SpeedMenuView.axaml</DependentUpon>
      </Compile>
      <Compile Update="Views\LastFmView.axaml.cs">
        <DependentUpon>LastFmView.axaml</DependentUpon>
      </Compile>
    </ItemGroup>
</Project>
