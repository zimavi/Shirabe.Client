<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:views="using:Shirabe.Client.Views"
             xmlns:loc="using:Shirabe.Client.Localization"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Shirabe.Client.Views.ConnectionsSettingsView"
             x:DataType="vm:ConnectionsSettingsViewModel">
    <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="{loc:T Connections_SectionDiscord}" />
        <views:SettingRow Title="{loc:T Connections_Presence}" Description="{loc:T Connections_PresenceDescription}">
            <ToggleSwitch IsChecked="{Binding Settings.DiscordPresenceEnabled}"
                          AutomationProperties.Name="{loc:T Connections_PresenceName}" />
        </views:SettingRow>
        <views:SettingRow Title="{loc:T Connections_CoverLookup}"
                          Description="{loc:T Connections_CoverLookupDescription}"
                          IsEnabled="{Binding Settings.DiscordPresenceEnabled}">
            <ToggleSwitch IsChecked="{Binding Settings.CoverLookupEnabled}"
                          AutomationProperties.Name="{loc:T Connections_CoverLookupName}" />
        </views:SettingRow>

        <views:LastFmView DataContext="{Binding LastFm}" Margin="0,12,0,0" />

        <TextBlock Classes="section" Text="{loc:T Connections_SectionArtwork}" Margin="0,12,0,0" />
        <views:SettingRow Title="{loc:T Connections_DownloadArtwork}"
                          Description="{loc:T Connections_DownloadArtworkDescription}">
            <ToggleSwitch IsChecked="{Binding Settings.DownloadArtworkEnabled}"
                          AutomationProperties.Name="{loc:T Connections_DownloadArtwork}" />
        </views:SettingRow>

        <TextBlock Classes="section" Text="{loc:T Connections_SectionUpdates}" Margin="0,12,0,0" />
        <views:SettingRow Title="{loc:T Connections_CheckForUpdates}"
                          Description="{loc:T Connections_CheckForUpdatesDescription}">
            <ToggleSwitch IsChecked="{Binding Settings.CheckForUpdatesEnabled}"
                          AutomationProperties.Name="{loc:T Connections_CheckForUpdates}" />
        </views:SettingRow>
    </StackPanel>
</UserControl>