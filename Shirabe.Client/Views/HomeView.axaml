<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Shirabe.Client.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <Panel>
        <Panel Classes="dropzone" Width="440" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle IsHitTestVisible="False" />
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <PathIcon Data="{DynamicResource Icon.Note}" Width="48" Height="48"
                          Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="Drop an audio file here" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="to start listening" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Panel>

        <TextBlock Text="{Binding Notice}"
                   IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="IndianRed" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" />
    </Panel>
</UserControl>
