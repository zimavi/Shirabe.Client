<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:loc="using:Shirabe.Client.Localization"
             xmlns:conv="using:Shirabe.Client.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Shirabe.Client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid ColumnDefinitions="260,*" Margin="32,16,32,0">
        <!-- The pages; the open one is shown on the right, its view found from its view model type (see ViewLocator) -->
        <StackPanel Grid.Column="0" Spacing="12" Margin="0,0,24,0">
            <TextBlock Classes="page-title" Text="{loc:T Nav_Settings}" />
            <ListBox Classes="settings-pages" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsPageViewModel">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4">
                            <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconKeyConverter.Instance}}"
                                      Width="18" Height="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalAlignment="Stretch">
            <ContentControl Content="{Binding SelectedPage}" MaxWidth="680" HorizontalAlignment="Left"
                            Margin="0,8,16,24" />
        </ScrollViewer>
    </Grid>
</UserControl>