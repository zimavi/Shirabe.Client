<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:conv="using:Shirabe.Client.Converters"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="600"
             x:Class="Shirabe.Client.Views.LyricsView"
             x:DataType="vm:LyricsViewModel">
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="20,16,20,8" Spacing="2">
                <TextBlock Text="Lyrics" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SourceText}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding SourceText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" IsVisible="{Binding HasLyrics}" HorizontalScrollBarVisibility="Disabled">
                <!-- Timed lyrics: the line being sung is bright, the others dimmed, and a click moves playback to that line.
                     A line the file times word by word is a row of words that light up as they start. Plain lyrics are all readable. -->
                <ItemsControl x:Name="LinesList" ItemsSource="{Binding Lines}" Classes.timed="{Binding IsSynced}" Margin="20,8,20,120"
                              FontSize="{Binding FontSize}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LyricLineViewModel">
                            <Button Classes="lyric-line" Classes.current="{Binding IsCurrent}" Classes.second="{Binding IsSecondVoice}" Classes.group="{Binding IsGroupVoice}" IsHitTestVisible="{Binding !IsGap}"
                                    IsVisible="{Binding IsShown}"
                                    Command="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).SeekToLineCommand}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Text}">
                                <StackPanel>
                                    <TextBlock Classes="lyric" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding ShowsText}" />
                                    <!-- An instrumental break: three dots that fill in over its length -->
                                    <StackPanel Classes="pause" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsPause}">
                                        <TextBlock Classes="lyric" Text="●" Opacity="{Binding Dot1}" />
                                        <TextBlock Classes="lyric" Text="●" Opacity="{Binding Dot2}" />
                                        <TextBlock Classes="lyric" Text="●" Opacity="{Binding Dot3}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Words}" IsVisible="{Binding HasWords}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LyricWordViewModel">
                                                <!-- Two copies of the word: dim below, bright above, and the bright one is masked to the part that has been sung. -->
                                                <Grid Classes="word" Classes.spaced="{Binding SpaceAfter}">
                                                    <TextBlock Classes="lyric word" Text="{Binding Text}" IsVisible="{Binding !IsComplete}" />
                                                    <TextBlock Classes="lyric word overlay" Text="{Binding Text}" IsVisible="{Binding HasStarted}"
                                                               OpacityMask="{Binding Progress, Converter={x:Static conv:WordFillConverter.Instance}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="lyric aside" Text="{Binding Background}" TextWrapping="Wrap" IsVisible="{Binding BackgroundTextVisible}"
                                               FontSize="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).AsideFontSize}" />
                                    <ItemsControl ItemsSource="{Binding BackgroundWords}" IsVisible="{Binding BackgroundWordsVisible}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LyricWordViewModel">
                                                <Grid Classes="word" Classes.spaced="{Binding SpaceAfter}">
                                                    <TextBlock Classes="lyric word aside" Text="{Binding Text}" IsVisible="{Binding !IsComplete}"
                                                               FontSize="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).AsideFontSize}" />
                                                    <TextBlock Classes="lyric word aside overlay" Text="{Binding Text}" IsVisible="{Binding HasStarted}"
                                                               OpacityMask="{Binding Progress, Converter={x:Static conv:WordFillConverter.Instance}}"
                                                               FontSize="{Binding $parent[UserControl].((vm:LyricsViewModel)DataContext).AsideFontSize}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Spacing="6" Margin="24,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding HasNoLyrics}">
                <TextBlock Text="{Binding NoLyricsText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding NoLyricsHint}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
