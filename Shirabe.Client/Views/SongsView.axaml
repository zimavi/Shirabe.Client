<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:lib="using:Shirabe.Core.Library"
             xmlns:conv="using:Shirabe.Client.Converters"
             xmlns:views="using:Shirabe.Client.Views"
             xmlns:loc="using:Shirabe.Client.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Shirabe.Client.Views.SongsView"
             x:DataType="vm:SongsViewModel">
    <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32,16,32,0">
            <!-- Heading and actions -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="page-title" Text="{loc:T Nav_Songs}" />
                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="quiet" Content="{loc:T Songs_Cancel}" Command="{Binding CancelScanCommand}"
                            IsVisible="{Binding IsScanning}" Padding="14,8" />
                    <Button Classes="accent" Content="{loc:T Songs_AddFolder}" Command="{Binding AddFolderCommand}" />
                </StackPanel>
            </Grid>

            <!-- Scan progress / last scan summary / errors -->
            <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,0">
                <ProgressBar Minimum="0" Maximum="{Binding ScanTotal}" Value="{Binding ScanProcessed}"
                             IsVisible="{Binding IsScanning}" />
                <TextBlock Text="{Binding ScanText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           IsVisible="{Binding ScanText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="IndianRed" TextWrapping="Wrap"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <!-- Column headings, aligned with the row template below (the first column holds the cover) -->
            <Grid Grid.Row="2" ColumnDefinitions="44,3*,2*,2*,56" Margin="12,16,12,6"
                  IsVisible="{Binding HasTracks}">
                <TextBlock Grid.Column="1" Classes="section" Text="{loc:T Songs_ColTitle}" />
                <TextBlock Grid.Column="2" Classes="section" Text="{loc:T Songs_ColArtist}" />
                <TextBlock Grid.Column="3" Classes="section" Text="{loc:T Songs_ColAlbum}" />
                <TextBlock Grid.Column="4" Classes="section" Text="{loc:T Songs_ColTime}" TextAlignment="Right" />
            </Grid>

            <Panel Grid.Row="3">
                <ListBox x:Name="SongList" Classes="songs" ItemsSource="{Binding Tracks}" SelectionMode="Single"
                         IsVisible="{Binding HasTracks}"
                         DoubleTapped="OnDoubleTapped">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="RowMenu" Opening="OnMenuOpening" Closed="OnMenuClosed">
                            <MenuItem Header="{loc:T Player_Play}" Click="OnPlayClick" />
                            <MenuItem Header="{loc:T Songs_PlayNext}" Click="OnPlayNextClick" />
                            <MenuItem Header="{loc:T Songs_AddToQueue}" Click="OnAddToQueueClick" />
                            <Separator />
                            <MenuItem Header="{loc:T Songs_Properties}" Click="OnPropertiesClick" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="lib:TrackSummary">
                            <Grid ColumnDefinitions="44,3*,2*,2*,56" Margin="0,4">
                                <views:CoverView Grid.Column="0" Width="36" Height="36" HorizontalAlignment="Left"
                                                 ArtworkPath="{Binding ArtworkPath}" />
                                <!-- Darkens the cover and plays the song; visible only while the row is hovered (see Controls.axaml) -->
                                <Button Grid.Column="0" Classes="cover-play" HorizontalAlignment="Left"
                                        Focusable="False"
                                        Command="{Binding $parent[ListBox].((vm:SongsViewModel)DataContext).PlayCommand}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{loc:T Player_Play}">
                                    <PathIcon Data="{DynamicResource Icon.Play}" />
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                <!-- A song with no artist shows a translated placeholder; a binding's TargetNullValue cannot follow the language -->
                                <TextBlock Grid.Column="2" Text="{Binding Artist}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                           IsVisible="{Binding Artist, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Grid.Column="2" Text="{loc:T Common_UnknownArtist}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                           IsVisible="{Binding Artist, Converter={x:Static ObjectConverters.IsNull}}" />
                                <TextBlock Grid.Column="3" Text="{Binding Album}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                           Text="{Binding Duration, Converter={x:Static conv:TimeSpanTextConverter.Instance}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Nothing in the library yet -->
                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding ShowEmptyState}">
                    <PathIcon Data="{DynamicResource Icon.Note}" Width="40" Height="40"
                              Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T Songs_EmptyTitle}" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:T Songs_EmptyHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>
        </Grid>

        <!-- The properties dialog of a song, over the whole page -->
        <Border Background="#B0000000"
                IsVisible="{Binding Properties, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl Content="{Binding Properties}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Panel>
</UserControl>