<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:views="using:Shirabe.Client.Views"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Shirabe.Client.Views.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">
    <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="STARTUP" />
        <views:SettingRow Title="Resume last session"
                          Description="Brings back the last song (paused, where you left it), the volume, shuffle and repeat when Shirabe starts. Off forgets them.">
            <ToggleSwitch IsChecked="{Binding Settings.ResumeLastSession}" AutomationProperties.Name="Resume last session" />
        </views:SettingRow>
    </StackPanel>
</UserControl>
