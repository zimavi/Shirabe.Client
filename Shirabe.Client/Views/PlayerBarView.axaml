<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:views="using:Shirabe.Client.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="88"
             x:Class="Shirabe.Client.Views.PlayerBarView"
             x:DataType="vm:PlayerViewModel">
    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,1,0,0"
            Height="88"
            Padding="16,0">
        <Grid ColumnDefinitions="*,2*,*" VerticalAlignment="Center">
            <!-- Now playing -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <views:CoverView Width="56" Height="56" ArtworkPath="{Binding ArtworkPath}" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="240" />
                    <!-- The artist; replaced by the reason when the last attempt to play failed -->
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNull}}" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" MaxWidth="240" MaxLines="2"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="IndianRed"
                               ToolTip.Tip="{Binding ErrorMessage}"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </StackPanel>

            <!-- Transport and progress -->
            <Grid Grid.Column="1" RowDefinitions="40,Auto" RowSpacing="2" MaxWidth="560" Margin="24,0"
                  VerticalAlignment="Center">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Classes="icon" Classes.active="{Binding IsShuffleOn}" Command="{Binding ToggleShuffleCommand}"
                            ToolTip.Tip="Shuffle" AutomationProperties.Name="Shuffle">
                        <PathIcon Data="{DynamicResource Icon.Shuffle}" />
                    </Button>
                    <Button Classes="icon" Command="{Binding PreviousCommand}"
                            ToolTip.Tip="Previous" AutomationProperties.Name="Previous">
                        <PathIcon Data="{DynamicResource Icon.SkipPrevious}" Width="22" Height="22" />
                    </Button>
                    <Button Classes="play" Command="{Binding TogglePlayPauseCommand}"
                            AutomationProperties.Name="Play or pause">
                        <Panel>
                            <PathIcon Data="{DynamicResource Icon.Play}" Width="22" Height="22"
                                      IsVisible="{Binding !IsPlaying}" />
                            <PathIcon Data="{DynamicResource Icon.Pause}" Width="22" Height="22"
                                      IsVisible="{Binding IsPlaying}" />
                        </Panel>
                    </Button>
                    <Button Classes="icon" Command="{Binding NextCommand}"
                            ToolTip.Tip="Next" AutomationProperties.Name="Next">
                        <PathIcon Data="{DynamicResource Icon.SkipNext}" Width="22" Height="22" />
                    </Button>
                    <Button Classes="icon" Classes.active="{Binding IsRepeatActive}" Command="{Binding CycleRepeatCommand}"
                            ToolTip.Tip="{Binding RepeatText}" AutomationProperties.Name="Repeat">
                        <Panel>
                            <PathIcon Data="{DynamicResource Icon.Repeat}" IsVisible="{Binding !IsRepeatOne}" />
                            <PathIcon Data="{DynamicResource Icon.RepeatOne}" IsVisible="{Binding IsRepeatOne}" />
                        </Panel>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="12" MinWidth="36"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Slider Grid.Column="1" Classes="shirabe" Theme="{StaticResource ShirabeSlider}" Minimum="0" Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            IsEnabled="{Binding HasMedia}" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" MinWidth="36"
                               TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Grid>

            <!-- Queue and volume -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="icon" Classes.active="{Binding IsQueueOpen}" Command="{Binding ToggleQueueCommand}"
                        ToolTip.Tip="Queue" AutomationProperties.Name="Queue">
                    <PathIcon Data="{DynamicResource Icon.Playlist}" />
                </Button>
                <PathIcon Data="{DynamicResource Icon.Volume}" Width="18" Height="18"
                          Foreground="{DynamicResource TextSecondaryBrush}" />
                <Slider Classes="shirabe" Theme="{StaticResource ShirabeSlider}" Minimum="0" Maximum="1" Width="110" Value="{Binding Volume, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
