<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:views="using:Shirabe.Client.Views"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Shirabe.Client.Views.MainView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <!-- Shown instead of the shell when the audio engine could not start -->
        <TextBlock Text="{Binding StartupError}"
                   IsVisible="{Binding StartupError, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="IndianRed"
                   TextWrapping="Wrap"
                   MaxWidth="520"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <Grid RowDefinitions="*,Auto"
              IsVisible="{Binding Player, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid Grid.Row="0" ColumnDefinitions="232,*">
                <views:SidebarView Grid.Column="0" />

                <!-- The current page; the view is found from the view model type (see ViewLocator).
                     The top margin keeps pages clear of the title bar strip. -->
                <TransitioningContentControl Grid.Column="1" Classes="pages" Content="{Binding CurrentPage}"
                                             Margin="0,40,0,0" />

                <!-- The queue overlays the right side of the page. Closed, it waits just outside the window (see
                     Panel.queue-panel in Controls.axaml) and is disabled, so it cannot take focus or clicks. -->
                <Panel Grid.Column="1" Width="340" HorizontalAlignment="Right" Margin="0,40,0,0"
                       Classes="queue-panel" Classes.open="{Binding Player.IsQueueOpen}"
                       IsEnabled="{Binding Player.IsQueueOpen}">
                    <views:QueueView DataContext="{Binding Player}" />
                </Panel>

                <!-- Lyrics take the queue's place (the player closes one when the other opens), with the same open/close style. -->
                <Panel Grid.Column="1" Width="340" HorizontalAlignment="Right" Margin="0,40,0,0"
                       Classes="queue-panel" Classes.open="{Binding Player.IsLyricsOpen}"
                       IsEnabled="{Binding Player.IsLyricsOpen}">
                    <views:LyricsView DataContext="{Binding Lyrics}" />
                </Panel>

                <!-- Notifications float over everything in the page area -->
                <views:NotificationsView Grid.Column="1" DataContext="{Binding Notifications}"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" />
            </Grid>

            <views:PlayerBarView Grid.Row="1" DataContext="{Binding Player}" />
        </Grid>

        <!-- Outside the shell, so the window can still be moved and closed when the audio engine failed to start -->
        <views:TitleBarView VerticalAlignment="Top" />
    </Grid>
</UserControl>