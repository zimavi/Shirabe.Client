<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:views="using:Shirabe.Client.Views"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Shirabe.Client.Views.MainView"
             x:DataType="vm:MainViewModel"
             DragDrop.AllowDrop="True">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <!-- Shown instead of the shell when the audio engine could not start -->
        <TextBlock Text="{Binding StartupError}"
                   IsVisible="{Binding StartupError, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="IndianRed"
                   TextWrapping="Wrap"
                   MaxWidth="520"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <Grid RowDefinitions="*,Auto"
              IsVisible="{Binding Player, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid Grid.Row="0" ColumnDefinitions="232,*">
                <views:SidebarView Grid.Column="0" />

                <!-- Content area. Home is only the drop target for now. -->
                <Panel Grid.Column="1">
                    <Panel x:Name="DropZone" Classes="dropzone" Width="440" Height="280"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle IsHitTestVisible="False" />
                        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <PathIcon Data="{DynamicResource Icon.Note}" Width="48" Height="48"
                                      Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Drop an audio file here" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="to start listening" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Player.ErrorMessage}"
                                       IsVisible="{Binding Player.ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Foreground="IndianRed" TextWrapping="Wrap" MaxWidth="380"
                                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Panel>
                </Panel>
            </Grid>

            <views:PlayerBarView Grid.Row="1" DataContext="{Binding Player}" />
        </Grid>

        <!-- Outside the shell, so the window can still be moved and closed when the audio engine failed to start -->
        <views:TitleBarView VerticalAlignment="Top" />
    </Grid>
</UserControl>
