<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:views="using:Shirabe.Client.Views"
             xmlns:loc="using:Shirabe.Client.Localization"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Shirabe.Client.Views.AppearanceSettingsView"
             x:DataType="vm:AppearanceSettingsViewModel">
    <StackPanel Spacing="24">
        <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="{loc:T Appearance_SectionTheme}" />
            <views:SettingRow Title="{loc:T Appearance_Theme}" Description="{loc:T Appearance_ThemeDescription}">
                <ComboBox ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding Settings.ThemeName}" MinWidth="160"
                          AutomationProperties.Name="{loc:T Appearance_Theme}" />
            </views:SettingRow>
            <TextBlock Text="{Binding CustomThemesHint}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding ThemeProblems}" FontSize="12" TextWrapping="Wrap" Foreground="IndianRed"
                       IsVisible="{Binding HasThemeProblems}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="{loc:T Appearance_SectionAccent}" />
            <views:SettingRow Title="{loc:T Appearance_Follow}" Description="{loc:T Appearance_FollowDescription}">
                <ToggleSwitch IsChecked="{Binding Settings.FollowCoverAccent}"
                              AutomationProperties.Name="{loc:T Appearance_Follow}" />
            </views:SettingRow>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="{loc:T Appearance_SectionMotion}" />
            <views:SettingRow Title="{loc:T Appearance_ReduceMotion}"
                              Description="{loc:T Appearance_ReduceMotionDescription}">
                <ToggleSwitch IsChecked="{Binding Settings.ReduceMotion}"
                              AutomationProperties.Name="{loc:T Appearance_ReduceMotion}" />
            </views:SettingRow>
        </StackPanel>
    </StackPanel>
</UserControl>