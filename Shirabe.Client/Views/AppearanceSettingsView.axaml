<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Shirabe.Client.ViewModels"
             xmlns:views="using:Shirabe.Client.Views"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Shirabe.Client.Views.AppearanceSettingsView"
             x:DataType="vm:AppearanceSettingsViewModel">
    <StackPanel Spacing="24">
        <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="THEME" />
            <views:SettingRow Title="Theme" Description="The colours of the whole app.">
                <ComboBox ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding Settings.ThemeName}" MinWidth="160"
                          AutomationProperties.Name="Theme" />
            </views:SettingRow>
            <TextBlock Text="{Binding CustomThemesHint}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding ThemeProblems}" FontSize="12" TextWrapping="Wrap" Foreground="IndianRed"
                       IsVisible="{Binding HasThemeProblems}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="ACCENT" />
            <views:SettingRow Title="Follow the cover"
                              Description="Tints the accent colour from the cover of the song that is playing. Off keeps the theme's own accent.">
                <ToggleSwitch IsChecked="{Binding Settings.FollowCoverAccent}" AutomationProperties.Name="Follow the cover" />
            </views:SettingRow>
        </StackPanel>
    </StackPanel>
</UserControl>
