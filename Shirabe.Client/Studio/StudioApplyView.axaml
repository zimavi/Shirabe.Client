<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:studio="using:Shirabe.Client.Studio"
             xmlns:lib="using:Shirabe.Core.Library"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="560"
             x:Class="Shirabe.Client.Studio.StudioApplyView"
             x:DataType="studio:StudioApplyViewModel">
    <!-- Choose the song a document is applied to. Shown over the Studio page. -->
    <Border Width="640" MaxHeight="660" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}">
        <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Spacing="2" Margin="24,20,24,12">
                <TextBlock Text="Apply to a song" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="12" Margin="24,0,24,16">
                    <TextBox Text="{Binding Filter}" PlaceholderText="Search your songs" AutomationProperties.Name="Search your songs" />
                    <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="#6CC38A" IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ListBox Classes="songs" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}" SelectionMode="Single"
                             MaxHeight="220" AutomationProperties.Name="Songs">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="lib:TrackSummary">
                                <StackPanel Spacing="1" Margin="0,3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ContentControl Content="{Binding Preview}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                <Button Classes="quiet" Content="Close" Padding="16,8" HorizontalAlignment="Right" Command="{Binding CloseCommand}" />
            </Border>
        </Grid>
    </Border>
</UserControl>
