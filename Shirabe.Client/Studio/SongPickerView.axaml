<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:studio="using:Shirabe.Client.Studio"
             xmlns:lib="using:Shirabe.Core.Library"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="Shirabe.Client.Studio.SongPickerView"
             x:DataType="studio:SongPickerViewModel">
    <!-- Choose a song (and, for a new document, its layer). Shown over a Studio page. -->
    <Border Width="600" MaxHeight="600" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMedium}">
        <Grid RowDefinitions="Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" Margin="24,20,24,12" />

            <StackPanel Grid.Row="1" Spacing="12" Margin="24,0,24,16">
                <StackPanel Spacing="4" IsVisible="{Binding ChooseLayer}">
                    <TextBlock Classes="section" Text="WRITTEN AS" />
                    <ComboBox ItemsSource="{x:Static studio:SongPickerViewModel.LayerNames}" SelectedIndex="{Binding SelectedLayerIndex}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Layer of the new document" />
                </StackPanel>
                <TextBox Text="{Binding Filter}" PlaceholderText="Search your songs" AutomationProperties.Name="Search your songs" />
                <ListBox Classes="songs" ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}" SelectionMode="Single"
                         MaxHeight="260" AutomationProperties.Name="Songs">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="lib:TrackSummary">
                            <StackPanel Spacing="1" Margin="0,3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,12">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="quiet" Content="Close" Padding="16,8" Command="{Binding CloseCommand}" />
                    <Button Classes="accent" Content="{Binding ActionText}" Command="{Binding ChooseCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
